{
  "name": "dsh-view",
  "version": "1.0.0",
  "description": "DSH native tools for the R3 graph analysis runtime",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./runtime": "./runtime/service.mjs"
  },
  "files": [
    "src",
    "runtime",
    "assets",
    "examples",
    "skills",
    "cordis.patch.yml",
    "scripts",
    "README.md",
    "SECURITY.md",
    "PROVENANCE.md",
    "tests",
    "TEST-REPORT.md",
    "package-lock.json"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "setup": "node scripts/setup.mjs",
    "pack:check": "npm pack --dry-run",
    "test:browser": "node scripts/browser-test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "playwright": "1.56.1"
  },
  "license": "UNLICENSED",
  "dsh": {
  "bundle": {
    "patch": "./cordis.patch.yml"
  }
}
}
